# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Hotmart (forma de pagamento PRINCIPAL — Brasil)
# 1. Crie o produto em Produtos > Novo produto no painel da Hotmart
# 2. Em Ferramentas > Webhook, cadastre a URL: https://seu-app.vercel.app/api/hotmart/webhook
#    e copie o "Hottok" gerado para HOTMART_HOTTOK abaixo
# 3. Configure O QUE DIFERENCIA CADA PLANO no seu produto:
#    - Se você tem UM produto com vários planos de assinatura (o mais comum):
#      use HOTMART_PLAN_PLUS/PRO/BUSINESS com o "Plan ID" de cada oferta
#      (aparece em data.subscription.plan.id no payload do webhook)
#    - Se você tem PRODUTOS SEPARADOS (um produto por plano):
#      use HOTMART_PRODUCT_PLUS/PRO/BUSINESS com o "Product ID" de cada produto
# 4. HOTMART_CHECKOUT_PLUS é o link de checkout (ex: https://go.hotmart.com/XXXXXXXXX)
HOTMART_HOTTOK=
# "Basic" na Hotmart é o plano de entrada, que libera o tier "free" do sistema
HOTMART_PLAN_BASIC=
HOTMART_PLAN_PLUS=
HOTMART_PLAN_PRO=
HOTMART_PLAN_BUSINESS=
HOTMART_PRODUCT_BASIC=
HOTMART_PRODUCT_PLUS=
HOTMART_PRODUCT_PRO=
HOTMART_PRODUCT_BUSINESS=
HOTMART_CHECKOUT_PLUS=
HOTMART_CHECKOUT_PRO=
HOTMART_CHECKOUT_BUSINESS=

# Stripe (alternativa — cartão internacional / venda para fora do Brasil, opcional por enquanto)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PLUS=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# App
APP_URL=https://seu-app.vercel.app
