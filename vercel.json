{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/triagem", "dest": "/public/triagem.html" },
    { "src": "/apresentacao", "dest": "/public/apresentacao.html" },
    { "src": "/(.*\\.(js|mjs|css|html|json|webmanifest|png|jpg|jpeg|webp|gif|svg|ico|woff2?|ttf|otf|wasm|map|txt|xml|pdf|mp4|webm|gz|traineddata))", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
